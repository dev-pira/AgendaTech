# Copie este arquivo para .env e preencha com valores reais.
# NUNCA faça commit do .env (já está no .gitignore).

# Connection string do PostgreSQL (ex.: Neon, Supabase, RDS ou instância local)
DATABASE_URL="postgresql://usuario:senha@host:5432/agendatech?schema=public"

# Segredo usado para assinar os tokens JWT — gere algo forte, ex.: `openssl rand -hex 32`
JWT_SECRET="troque-por-um-segredo-forte-antes-de-subir"
JWT_EXPIRES_IN="7d"

PORT=3333
NODE_ENV=development
