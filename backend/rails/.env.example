# Obrigatória em TODOS os ambientes, incluindo development (não usamos
# config/credentials nesta versão — ver README.md). Gere uma com:
# ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=
