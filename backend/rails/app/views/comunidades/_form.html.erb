<% if comunidade.errors.any? %>
  <div class="errors">
    <ul style="margin: 0; padding-left: 1.25rem;">
      <% comunidade.errors.full_messages.each do |mensagem| %>
        <li><%= mensagem %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: comunidade, url: url, method: method do |f| %>
  <%= f.label :nome, "Nome" %>
  <%= f.text_field :nome, required: true %>

  <%= f.label :descricao, "Descrição" %>
  <%= f.text_area :descricao, rows: 4, required: true %>

  <%= f.label :cidade, "Cidade" %>
  <%= f.text_field :cidade, required: true %>

  <%= f.label :contato, "Contato (e-mail ou URL)" %>
  <%= f.text_field :contato, required: true %>

  <%= f.label :logo_url, "URL da logo (opcional)" %>
  <%= f.text_field :logo_url %>

  <%= f.submit "Salvar" %>
<% end %>
