<% content_for :title, "Comunidades" %>

<h1>Comunidades</h1>

<%= form_with url: comunidades_path, method: :get do %>
  <div style="display:flex; gap:.5rem; align-items:end;">
    <div style="flex:1;">
      <%= label_tag :busca, "Buscar" %>
      <%= text_field_tag :busca, @busca, placeholder: "Nome da comunidade" %>
    </div>
    <div style="flex:1;">
      <%= label_tag :cidade, "Cidade" %>
      <%= text_field_tag :cidade, @cidade_selecionada, placeholder: "Cidade" %>
    </div>
    <%= submit_tag "Filtrar" %>
  </div>
<% end %>

<% if logged_in? %>
  <p><%= link_to "+ Nova comunidade", new_comunidade_path, class: "btn" %></p>
<% end %>

<% if @comunidades.any? %>
  <% @comunidades.each do |comunidade| %>
    <div class="card">
      <h2><%= link_to comunidade.nome, comunidade_path(comunidade) %></h2>
      <p><%= comunidade.cidade %> — <%= comunidade.total_membros %> membro(s)</p>
      <p><%= comunidade.descricao %></p>
    </div>
  <% end %>
<% else %>
  <p>Nenhuma comunidade encontrada.</p>
<% end %>

<div class="pagination">
  Página <%= @paginacao[:pagina_atual] %> de <%= @paginacao[:total_paginas] %>
  <% if @paginacao[:pagina_atual] > 1 %>
    <%= link_to "« Anterior", comunidades_path(request.query_parameters.merge(pagina: @paginacao[:pagina_atual] - 1)) %>
  <% end %>
  <% if @paginacao[:pagina_atual] < @paginacao[:total_paginas] %>
    <%= link_to "Próxima »", comunidades_path(request.query_parameters.merge(pagina: @paginacao[:pagina_atual] + 1)) %>
  <% end %>
</div>
