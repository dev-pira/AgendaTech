<% content_for :title, @evento.titulo %>

<h1><%= @evento.titulo %></h1>
<p><strong>Comunidade:</strong> <%= link_to @evento.comunidade.nome, comunidade_path(@evento.comunidade) %></p>
<p>
  <strong>Data:</strong> <%= @evento.data.strftime("%d/%m/%Y") %> — <%= @evento.hora_inicio.strftime("%H:%M") %>
  <% if @evento.hora_fim %> até <%= @evento.hora_fim.strftime("%H:%M") %><% end %>
</p>
<p><strong>Local:</strong> <%= @evento.local %></p>
<p><strong>Tipo:</strong> <%= @evento.tipo %></p>
<% if @evento.url_online.present? %>
  <p><strong>URL online:</strong> <%= link_to @evento.url_online, @evento.url_online %></p>
<% end %>
<p><%= @evento.descricao %></p>
<p><strong>Organizador:</strong> <%= @evento.organizador.nome_exibicao %></p>

<% if @pode_gerenciar %>
  <p>
    <%= link_to "Editar", edit_evento_path(@evento), class: "btn" %>
    <%= link_to "Excluir", confirm_delete_evento_path(@evento), class: "btn btn-danger" %>
  </p>
<% end %>
