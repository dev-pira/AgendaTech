<% if evento.errors.any? %>
  <div class="errors">
    <ul style="margin: 0; padding-left: 1.25rem;">
      <% evento.errors.full_messages.each do |mensagem| %>
        <li><%= mensagem %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: evento, url: url, method: method do |f| %>
  <%= f.label :titulo, "Título" %>
  <%= f.text_field :titulo, required: true %>

  <%= f.label :descricao, "Descrição" %>
  <%= f.text_area :descricao, rows: 4, required: true %>

  <%= f.label :data, "Data" %>
  <%= f.date_field :data, required: true %>

  <%= f.label :hora_inicio, "Hora de início" %>
  <%= f.time_field :hora_inicio, required: true %>

  <%= f.label :hora_fim, "Hora de fim (opcional)" %>
  <%= f.time_field :hora_fim %>

  <%= f.label :local, "Local" %>
  <%= f.text_field :local, required: true %>

  <%= f.label :tipo, "Tipo" %>
  <%= f.select :tipo, [["Presencial", "presencial"], ["Online", "online"], ["Híbrido", "hibrido"]], { selected: evento.tipo || "presencial" } %>

  <%= f.label :url_online, "URL online (obrigatório se online ou híbrido)" %>
  <%= f.text_field :url_online %>

  <% if comunidades.present? %>
    <%= f.label :comunidade_id, "Comunidade" %>
    <%= f.select :comunidade_id, comunidades.map { |c| [c.nome, c.id] } %>
  <% end %>

  <%= f.submit "Salvar" %>
<% end %>
