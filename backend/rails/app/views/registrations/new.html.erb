<% content_for :title, "Cadastro" %>

<h1>Criar conta</h1>

<% if @user.errors.any? %>
  <div class="errors">
    <ul style="margin: 0; padding-left: 1.25rem;">
      <% @user.errors.full_messages.each do |mensagem| %>
        <li><%= mensagem %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: cadastro_path, method: :post do |f| %>
  <%= f.label :username, "Usuário" %>
  <%= f.text_field :username, required: true, autofocus: true %>

  <%= f.label :email, "E-mail" %>
  <%= f.email_field :email, required: true %>

  <%= f.label :first_name, "Nome" %>
  <%= f.text_field :first_name, required: true %>

  <%= f.label :last_name, "Sobrenome" %>
  <%= f.text_field :last_name %>

  <%= f.label :password, "Senha" %>
  <%= f.password_field :password, required: true %>

  <%= f.label :password_confirmation, "Confirme a senha" %>
  <%= f.password_field :password_confirmation, required: true %>

  <%= f.submit "Cadastrar" %>
<% end %>
