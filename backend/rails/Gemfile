source "https://rubygems.org"

ruby "3.2.3"

gem "rails", "~> 7.1.3"

# Banco de dados — MySQL é o padrão deste projeto (ver README.md).
gem "mysql2", "~> 0.5"

# Servidor de aplicação
gem "puma", ">= 5.0"

# Hashing de senha para User#authenticate (has_secure_password)
gem "bcrypt", "~> 3.1.7"

# Carrega variáveis de config/.env — mesmo padrão usado nas versões
# Django e Laravel deste backend.
gem "dotenv-rails"

# Acelera o boot da aplicação em cache de arquivos já carregados
gem "bootsnap", require: false

gem "tzinfo-data", platforms: %i[windows jruby]

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
end

group :test do
  # Rails 7.1's test-runner glue code (Rails::TestUnit::LineFiltering) isn't
  # compatible with Minitest 6's changed Runnable#run signature — pin to the
  # 5.x line until upgrading Rails.
  gem "minitest", "< 6"
end
